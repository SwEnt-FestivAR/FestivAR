rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /audio/voice-note/{taskId}/{file} {
      // Note: read and delete are currently allowed for any signed-in user because Firebase
      // Storage rules cannot easily verify Firestore task ownership. This is a known security
      // limitation to be addressed in a future sprint (e.g., via task ownership validation or security tokens).
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 20 * 1024 * 1024
                   && (request.resource.contentType == null || request.resource.contentType.matches('audio/.*'));
      allow delete: if request.auth != null;
    }
  }
}
